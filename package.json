{
  "name": "forma-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "pnpm --filter @forma/web dev",
    "dev:web": "pnpm --filter @forma/web dev",
    "dev:api": "pnpm --filter @forma/api start",
    "build": "pnpm build:web && pnpm build:api",
    "build:web": "pnpm --filter @forma/web build",
    "build:api": "pnpm --filter @forma/api build",
    "typecheck": "pnpm typecheck:web && pnpm typecheck:api",
    "typecheck:web": "pnpm --filter @forma/web typecheck",
    "typecheck:api": "pnpm --filter @forma/api typecheck",
    "lint": "eslint apps --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --write apps/web/src/features/task-form/ui/task-linked-files-panel.tsx && git diff -- apps/web/src/features/task-form/ui/task-linked-files-panel.tsx && exit 1",
    "test": "pnpm test:web && pnpm test:api",
    "test:web": "pnpm --filter @forma/web test",
    "test:api": "pnpm --filter @forma/api test",
    "test:frontend": "pnpm --filter @forma/web test:frontend",
    "benchmark:task-board": "pnpm --filter @forma/web benchmark:task-board",
    "benchmark:browser": "pnpm --filter @forma/web benchmark:browser",
    "preflight": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "prettier": "3.6.2",
    "typescript-eslint": "^8.46.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
