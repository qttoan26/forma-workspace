{
  "name": "@forma/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "build:performance": "vite build --config vite.performance.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b tsconfig.app.json tsconfig.node.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:frontend": "playwright test --config playwright.frontend.config.ts",
    "benchmark:task-board": "vitest bench tests/performance/task-board.bench.ts --run",
    "benchmark:browser": "playwright test --config playwright.performance.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-virtual": "^3.14.22",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
