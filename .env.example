# Frontend
# Optional. When set, project task reads and writes use the API instead of local browser persistence only.
VITE_API_BASE_URL=http://localhost:3001

# API
PORT=3001

# Comma-separated frontend origins allowed to call the API.
# Local Vite origins are used when this variable is omitted.
# For the deployed GitHub Pages frontend use: https://qttoan26.github.io
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. When set, the API uses PostgreSQL and runs pending SQL migrations on startup.
# When omitted, the API falls back to the in-memory task repository.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/forma_workspace
