# Frontend
# Set this only for a real production deployment. It enables strict frontend auth/config preflight.
# VITE_DEPLOYMENT_MODE=production

# Optional during local development. Required when VITE_DEPLOYMENT_MODE=production unless VITE_DEMO_MODE=true.
VITE_API_BASE_URL=http://localhost:3001

# Provider-neutral OIDC Authorization Code + PKCE settings.
# A real production frontend requires these values and HTTPS endpoints.
VITE_OIDC_AUTHORIZATION_ENDPOINT=https://issuer.example.com/authorize
VITE_OIDC_TOKEN_ENDPOINT=https://issuer.example.com/token
VITE_OIDC_CLIENT_ID=forma-web
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_SCOPE=openid profile email

# Reserved for the static GitHub Pages demo build. Do not enable for a real production deployment.
# VITE_DEMO_MODE=true

# API
PORT=3001

# Comma-separated frontend origins allowed to call the API.
# Local Vite origins are used when this variable is omitted in development.
# Required when NODE_ENV=production.
# For the deployed GitHub Pages frontend use: https://qttoan26.github.io
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional in development. When set, the API uses MongoDB persistence.
# Required when NODE_ENV=production; development falls back to the in-memory repository when omitted.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=forma_workspace

# Authentication
# Development without auth config uses AUTH_DEV_USER_ID (or local-development-user) so local work stays lightweight.
AUTH_DEV_USER_ID=local-development-user

# Required when authentication is enabled and always required in production.
AUTH_ISSUER=https://issuer.example.com
AUTH_AUDIENCE=forma-api

# Configure exactly one verifier:
# 1) Recommended for external OIDC providers. Production JWKS URLs must use HTTPS.
AUTH_JWKS_URL=https://issuer.example.com/.well-known/jwks.json

# 2) Or use a self-hosted HS256 secret with at least 32 characters.
# AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
